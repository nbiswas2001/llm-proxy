# Secrets for llm-proxy. Copy to .env and fill in; .env is not tracked by git.
# Referenced from config.toml as "${DEEPSEEK_API_KEY}" etc.
# A real environment variable of the same name overrides the value here.

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Only if llama-server was started with --api-key
# LLAMA_CPP_API_KEY=

# Log level, e.g. llm_proxy=debug to log every forwarded request
# LLM_PROXY_LOG=llm_proxy=info
